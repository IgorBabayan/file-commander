<Application xmlns="https://github.com/avaloniaui"
             
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="File.Commander.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://File.Commander/Presentation/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <avalonia:MaterialIconStyles />
        <StyleInclude Source="avares://File.Commander/Presentation/Styles/TextBlock.axaml" />
        <StyleInclude Source="avares://File.Commander/Presentation/Styles/Button.axaml" />
        <StyleInclude Source="avares://File.Commander/Presentation/Styles/ScrollBar.axaml" />
    </Application.Styles>
</Application>