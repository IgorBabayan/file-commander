<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:File.Commander.Presentation.ViewModels.Shell"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="File.Commander.Presentation.Views.Shell.ViewModeSwitcher"
             x:DataType="shell:MainViewModel">
    <!-- Grid / list / tree buttons. Fc* brushes follow the theme: DynamicResource -->
    <UserControl.Styles>
        <!-- Order matters: later styles win, so .selected and :disabled come last -->
        <Style Selector="Button.view-mode">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.view-mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="Button.view-mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>

        <!-- The active layout: a filled tile with an accent glyph -->
        <Style Selector="Button.view-mode.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcNavGroupBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
        </Style>
        <Style Selector="Button.view-mode.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
        </Style>

        <!-- Pages without a folder listing (Computer, Trash, ...): nothing to switch -->
        <Style Selector="Button.view-mode:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcDisabledTextBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="view-mode"
                Classes.selected="{Binding IsGridView}"
                Command="{Binding ShowGridViewCommand}"
                ToolTip.Tip="Grid (Ctrl+1)">
            <avalonia:MaterialIcon Kind="ViewGridOutline" Width="18" Height="18" />
        </Button>
        <Button Classes="view-mode"
                Classes.selected="{Binding IsListView}"
                Command="{Binding ShowListViewCommand}"
                ToolTip.Tip="List (Ctrl+2)">
            <avalonia:MaterialIcon Kind="FormatListBulleted" Width="18" Height="18" />
        </Button>
        <Button Classes="view-mode"
                Classes.selected="{Binding IsTreeView}"
                Command="{Binding ShowTreeViewCommand}"
                ToolTip.Tip="Tree (Ctrl+3)">
            <avalonia:MaterialIcon Kind="FileTreeOutline" Width="18" Height="18" />
        </Button>
    </StackPanel>
</UserControl>
