<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:File.Commander.Presentation.ViewModels.Shell"
        xmlns:computer="clr-namespace:File.Commander.Presentation.ViewModels.Computer"
        xmlns:pages="clr-namespace:File.Commander.Presentation.ViewModels.Pages"
        xmlns:browser="clr-namespace:File.Commander.Presentation.ViewModels.Browser"
        xmlns:browserViews="clr-namespace:File.Commander.Presentation.Views.Browser"
        xmlns:shellViews="clr-namespace:File.Commander.Presentation.Views.Shell"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="File.Commander.Presentation.Views.Shell.MainWindow"
        x:DataType="shell:MainViewModel"
        Width="1100" Height="700"
        MinWidth="820" MinHeight="520"
        Icon="/Assets/logo.png"
        Title="{Binding CurrentPage.Title, StringFormat='{}{0} — File Commander'}">
    <Window.Styles>
        <!-- ===== Title bar: back / forward pill ===== -->
        <Style Selector="Border.nav-group">
            <Setter Property="Background" Value="{DynamicResource FcNavGroupBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcDisabledTextBrush}" />
        </Style>

        <!-- ===== Title bar: blue "Computer" view button ===== -->
        <Style Selector="Button.view-toggle">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource FcAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.view-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>
        <Style Selector="Button.view-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>

        <!-- ===== Sidebar ===== -->
        <Style Selector="ListBox.sidebar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4,12,12" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem" x:DataType="shell:SidebarEntry">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>
        <Style Selector="ListBox.sidebar ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>
        <!-- Section headers are disabled items: keep them flat, no hover. -->
        <Style Selector="ListBox.sidebar ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Link pinned to the bottom of the sidebar: plain text link, no background in any state -->
        <Style Selector="HyperlinkButton.sidebar-link">
            <Setter Property="Margin" Value="24,0,12,16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
        </Style>
        <Style Selector="HyperlinkButton.sidebar-link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="HyperlinkButton.sidebar-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentHoverBrush}" />
        </Style>
        <Style Selector="HyperlinkButton.sidebar-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentPressedBrush}" />
        </Style>

        <Style Selector="Button.eject">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.eject:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcOverlayHoverBrush}" />
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
        </Style>
        <Style Selector="Button.eject:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcOverlayPressedBrush}" />
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
        </Style>

        <!-- ===== Content: cards ===== -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource FcCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcCardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcCardPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>

        <Style Selector="Button.directory-card">
            <Setter Property="Width" Value="106" />
            <Setter Property="Height" Value="136" />
            <Setter Property="Margin" Value="0,0,22,22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.disk-card">
            <Setter Property="Width" Value="282" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,22,22" />
            <Setter Property="Padding" Value="16,0,22,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Drive glyph -->
        <Style Selector="Border.disk-body">
            <Setter Property="Background" Value="{DynamicResource FcDiskBodyBrush}" />
        </Style>
        <Style Selector="Border.disk-body.removable">
            <Setter Property="Background" Value="{DynamicResource FcDiskBodyRemovableBrush}" />
        </Style>
        <Style Selector="Border.disk-base">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
        </Style>
        <Style Selector="Border.disk-base.removable">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MauveBrush}" />
        </Style>
        <Style Selector="Ellipse.disk-led">
            <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
        </Style>
        <Style Selector="Ellipse.disk-led.removable">
            <Setter Property="Fill" Value="{DynamicResource MauveBrush}" />
        </Style>

        <!-- Usage bar -->
        <Style Selector="ProgressBar.usage">
            <Setter Property="Height" Value="5" />
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource FcTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcUsageNormalBrush}" />
        </Style>
        <Style Selector="ProgressBar.usage.warning">
            <Setter Property="Foreground" Value="{DynamicResource FcUsageWarningBrush}" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource FcContentBrush}">
        <Grid RowDefinitions="52,*">
            <!-- ================= Title bar ================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource FcTitleBarBrush}"
                    PointerPressed="OnPointerPressed">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0,10,0">
                    <Image Grid.Column="0"
                           Source="/Assets/logo.png"
                           Width="30" Height="30"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                    <Border Grid.Column="1" Classes="nav-group" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="nav" ToolTip.Tip="Back (Alt+Left)" Command="{Binding GoBackCommand}">
                                <avalonia:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" />
                            </Button>
                            <Button Classes="nav" ToolTip.Tip="Forward (Alt+Right)" Command="{Binding GoForwardCommand}">
                                <avalonia:MaterialIcon Kind="ChevronRight" Width="20" Height="20" />
                            </Button>
                            <Button Classes="nav" ToolTip.Tip="Up (Alt+Up)" Command="{Binding GoUpCommand}">
                                <avalonia:MaterialIcon Kind="ArrowUp" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2"
                            Classes="view-toggle"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Computer"
                            Command="{Binding GoComputerCommand}">
                        <avalonia:MaterialIcon Kind="Monitor" Width="18" Height="18" />
                    </Button>

                    <!-- Address bar: breadcrumbs, click the empty part (or Ctrl+L) to type a path.
                         F5 still refreshes; the view switcher took the refresh button's place. -->
                    <Grid Grid.Column="3"
                          ColumnDefinitions="*,Auto,Auto"
                          Margin="12,0,16,0"
                          VerticalAlignment="Center">
                        <shellViews:AddressBar Grid.Column="0" DataContext="{Binding AddressBar}" />
                        <shellViews:SortButton Grid.Column="1" Margin="10,0,0,0" />
                        <shellViews:ViewModeSwitcher Grid.Column="2" Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <Button Classes="window-button" ToolTip.Tip="Search">
                            <avalonia:MaterialIcon Kind="Magnify" />
                        </Button>

                        <Button Classes="window-button"
                                ToolTip.Tip="Settings"
                                Command="{Binding SettingsCommand}"
                                Margin="0,0,12,0">
                            <avalonia:MaterialIcon Kind="Menu" />
                        </Button>

                        <Button Classes="window-button"
                                ToolTip.Tip="Minimize window"
                                Click="OnMinimizeClick"
                                IsVisible="{Binding IsNotHyprland}">
                            <avalonia:MaterialIcon Kind="WindowMinimize" />
                        </Button>

                        <Button Classes="window-button"
                                ToolTip.Tip="Maximize window"
                                Click="OnMaximizeClick"
                                IsVisible="{Binding IsNotHyprland}">
                            <avalonia:MaterialIcon Kind="WindowMaximize" />
                        </Button>

                        <Button Classes="window-button close"
                                ToolTip.Tip="Close window"
                                Click="OnCloseClick">
                            <avalonia:MaterialIcon Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Body ================= -->
            <Grid Grid.Row="1" ColumnDefinitions="200,*">
                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource FcSidebarBrush}">
                    <DockPanel>
                        <HyperlinkButton DockPanel.Dock="Bottom"
                                         Classes="sidebar-link"
                                         IsVisible="{Binding HasNotDesktopFile}"
                                         Command="{Binding CreateDesktopFileCommand}"
                                         Content="Create desktop file" />
                        <ListBox Classes="sidebar"
                                 ItemsSource="{Binding Sidebar.Entries}"
                                 SelectedItem="{Binding Sidebar.SelectedEntry}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="shell:SidebarHeader">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               Foreground="{DynamicResource FcHeaderTextBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>

                                <DataTemplate DataType="shell:SidebarItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Location}">
                                        <avalonia:MaterialIcon Grid.Column="0"
                                                               Kind="{Binding Icon}"
                                                               Width="18" Height="18"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Classes="eject"
                                                IsVisible="{Binding CanEject}"
                                                Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                                ToolTip.Tip="Eject">
                                            <avalonia:MaterialIcon Kind="Eject" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Current page -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                    <ContentControl Grid.Row="0" Content="{Binding CurrentPage}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="computer:ComputerViewModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="22,22,0,0">

                                        <TextBlock Classes="section-title" Text="My Directories" />

                                        <ItemsControl ItemsSource="{Binding Directories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="computer:DirectoryCardViewModel">
                                                    <Button Classes="card directory-card" ToolTip.Tip="{Binding Location}" Command="{Binding OpenCommand}">
                                                        <StackPanel Spacing="16">
                                                            <!-- Folder glyph: tab + gradient body + white badge -->
                                                            <Panel Width="58" Height="50" HorizontalAlignment="Center">
                                                                <Border Width="24" Height="10"
                                                                        Margin="3,0,0,0"
                                                                        CornerRadius="4,4,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource FcFolderTabBrush}" />
                                                                <Border Margin="0,5,0,0"
                                                                        CornerRadius="6"
                                                                        Background="{DynamicResource FcFolderBodyBrush}"
                                                                        BoxShadow="0 2 6 0 #66000000">
                                                                    <Border Width="24" Height="24"
                                                                            Margin="0,4,0,0"
                                                                            CornerRadius="12"
                                                                            Background="{DynamicResource FcFolderBadgeBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                        <avalonia:MaterialIcon Kind="{Binding Badge}"
                                                                                               Width="14" Height="14"
                                                                                               Foreground="{DynamicResource FcAccentBrush}" />
                                                                    </Border>
                                                                </Border>
                                                            </Panel>

                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       HorizontalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Classes="section-title" Text="Disks" Margin="0,8,0,20" />

                                        <ItemsControl ItemsSource="{Binding Disks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="computer:DiskCardViewModel">
                                                    <Button Classes="card disk-card" ToolTip.Tip="{Binding MountPoint}" Command="{Binding OpenCommand}">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Panel Grid.Column="0" Width="54" Height="58" VerticalAlignment="Center">
                                                                <!-- Hard drive / USB stick -->
                                                                <Grid Width="46"
                                                                      RowDefinitions="*,12"
                                                                      IsVisible="{Binding !IsOptical}">
                                                                    <Border Grid.Row="0"
                                                                            Classes="disk-body"
                                                                            Classes.removable="{Binding IsRemovable}"
                                                                            CornerRadius="5,5,0,0">
                                                                        <avalonia:MaterialIcon Kind="{Binding Glyph}"
                                                                                               IsVisible="{Binding HasGlyph}"
                                                                                               Width="24" Height="24"
                                                                                               Foreground="{DynamicResource FcOnAccentBrush}" />
                                                                    </Border>
                                                                    <Border Grid.Row="1"
                                                                            Classes="disk-base"
                                                                            Classes.removable="{Binding IsRemovable}"
                                                                            CornerRadius="0,0,5,5">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                                                              Margin="6,0"
                                                                              VerticalAlignment="Center">
                                                                            <Ellipse Grid.Column="0"
                                                                                     Width="4" Height="4"
                                                                                     Classes="disk-led"
                                                                                     Classes.removable="{Binding IsRemovable}" />
                                                                            <Border Grid.Column="2"
                                                                                    Width="12" Height="3"
                                                                                    CornerRadius="1"
                                                                                    Background="{DynamicResource Overlay0Brush}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Optical disc -->
                                                                <Panel Width="54" Height="54" IsVisible="{Binding IsOptical}">
                                                                    <Ellipse Fill="{DynamicResource FcOpticalDiscBrush}" />
                                                                    <Ellipse Width="20" Height="20" Fill="{DynamicResource Surface2Brush}" />
                                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource FcCardBrush}" />
                                                                </Panel>
                                                            </Panel>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="18,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="6">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="16"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding UsageText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource FcSubtleTextBrush}" />
                                                                <ProgressBar Classes="usage"
                                                                             Classes.warning="{Binding IsAlmostFull}"
                                                                             Value="{Binding UsedPercent}"
                                                                             Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <DataTemplate DataType="browser:DirectoryViewModel">
                                <browserViews:DirectoryView />
                            </DataTemplate>

                            <DataTemplate DataType="pages:PlaceholderPageViewModel">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                           Width="56" Height="56"
                                                           Foreground="{DynamicResource FcHeaderTextBrush}" />
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource FcSubtleTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>

                    <!-- Status bar -->
                    <Border Grid.Row="1"
                            Height="32"
                            BorderBrush="{DynamicResource FcDividerBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding CurrentPage.StatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource FcSubtleTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
