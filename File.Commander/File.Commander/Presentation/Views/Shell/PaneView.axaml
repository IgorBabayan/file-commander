<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:File.Commander.Presentation.ViewModels.Shell"
             xmlns:computer="clr-namespace:File.Commander.Presentation.ViewModels.Computer"
             xmlns:pages="clr-namespace:File.Commander.Presentation.ViewModels.Pages"
             xmlns:browser="clr-namespace:File.Commander.Presentation.ViewModels.Browser"
             xmlns:browserViews="clr-namespace:File.Commander.Presentation.Views.Browser"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="File.Commander.Presentation.Views.Shell.PaneView"
             x:DataType="shell:PaneViewModel">
    <!-- One view of the content area: its page and status bar. The card styles live in MainWindow.Styles;
         Fc* brushes follow the theme: DynamicResource -->
    <UserControl.Styles>
        <!-- A single view fills the area as before; in split view both get a frame, the active one in the accent color -->
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.pane.split">
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource FcDividerBrush}" />
        </Style>
        <Style Selector="Border.pane.split.active">
            <Setter Property="BorderBrush" Value="{DynamicResource FcAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Transparent background: a click on empty space still hits the view and makes it the active one -->
    <Border Classes="pane"
            Classes.split="{Binding IsSplit}"
            Classes.active="{Binding IsActive}">
        <Grid RowDefinitions="*,Auto">
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="computer:ComputerViewModel">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="22,22,0,0">

                                <TextBlock Classes="section-title" Text="My Directories" />

                                <ItemsControl ItemsSource="{Binding Directories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="computer:DirectoryCardViewModel">
                                            <Button Classes="card directory-card" ToolTip.Tip="{Binding Location}" Command="{Binding OpenCommand}">
                                                <StackPanel Spacing="16">
                                                    <!-- Folder glyph: tab + gradient body + white badge -->
                                                    <Panel Width="58" Height="50" HorizontalAlignment="Center">
                                                        <Border Width="24" Height="10"
                                                                Margin="3,0,0,0"
                                                                CornerRadius="4,4,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource FcFolderTabBrush}" />
                                                        <Border Margin="0,5,0,0"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource FcFolderBodyBrush}"
                                                                BoxShadow="0 2 6 0 #66000000">
                                                            <Border Width="24" Height="24"
                                                                    Margin="0,4,0,0"
                                                                    CornerRadius="12"
                                                                    Background="{DynamicResource FcFolderBadgeBrush}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <avalonia:MaterialIcon Kind="{Binding Badge}"
                                                                                       Width="14" Height="14"
                                                                                       Foreground="{DynamicResource FcAccentBrush}" />
                                                            </Border>
                                                        </Border>
                                                    </Panel>

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="section-title" Text="Disks" Margin="0,8,0,20" />

                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="computer:DiskCardViewModel">
                                            <Button Classes="card disk-card" ToolTip.Tip="{Binding MountPoint}" Command="{Binding OpenCommand}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Panel Grid.Column="0" Width="54" Height="58" VerticalAlignment="Center">
                                                        <!-- Hard drive / USB stick -->
                                                        <Grid Width="46"
                                                              RowDefinitions="*,12"
                                                              IsVisible="{Binding !IsOptical}">
                                                            <Border Grid.Row="0"
                                                                    Classes="disk-body"
                                                                    Classes.removable="{Binding IsRemovable}"
                                                                    CornerRadius="5,5,0,0">
                                                                <avalonia:MaterialIcon Kind="{Binding Glyph}"
                                                                                       IsVisible="{Binding HasGlyph}"
                                                                                       Width="24" Height="24"
                                                                                       Foreground="{DynamicResource FcOnAccentBrush}" />
                                                            </Border>
                                                            <Border Grid.Row="1"
                                                                    Classes="disk-base"
                                                                    Classes.removable="{Binding IsRemovable}"
                                                                    CornerRadius="0,0,5,5">
                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                      Margin="6,0"
                                                                      VerticalAlignment="Center">
                                                                    <Ellipse Grid.Column="0"
                                                                             Width="4" Height="4"
                                                                             Classes="disk-led"
                                                                             Classes.removable="{Binding IsRemovable}" />
                                                                    <Border Grid.Column="2"
                                                                            Width="12" Height="3"
                                                                            CornerRadius="1"
                                                                            Background="{DynamicResource Overlay0Brush}" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Optical disc -->
                                                        <Panel Width="54" Height="54" IsVisible="{Binding IsOptical}">
                                                            <Ellipse Fill="{DynamicResource FcOpticalDiscBrush}" />
                                                            <Ellipse Width="20" Height="20" Fill="{DynamicResource Surface2Brush}" />
                                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource FcCardBrush}" />
                                                        </Panel>
                                                    </Panel>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="18,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding UsageText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource FcSubtleTextBrush}" />
                                                        <ProgressBar Classes="usage"
                                                                     Classes.warning="{Binding IsAlmostFull}"
                                                                     Value="{Binding UsedPercent}"
                                                                     Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>

                    <DataTemplate DataType="browser:DirectoryViewModel">
                        <browserViews:DirectoryView />
                    </DataTemplate>

                    <DataTemplate DataType="pages:PlaceholderPageViewModel">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                   Width="56" Height="56"
                                                   Foreground="{DynamicResource FcHeaderTextBrush}" />
                            <TextBlock Text="{Binding Message}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FcSubtleTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Height="32"
                    BorderBrush="{DynamicResource FcDividerBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding CurrentPage.StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource FcSubtleTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
