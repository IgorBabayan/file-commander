<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:File.Commander.Presentation.ViewModels.Shell"
             xmlns:browser="clr-namespace:File.Commander.Presentation.ViewModels.Browser"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="File.Commander.Presentation.Views.Shell.SortButton"
             x:DataType="shell:MainViewModel">
    <!-- Sort button with its drop-down. Fc* brushes follow the theme: DynamicResource -->
    <UserControl.Styles>
        <!-- Same look as the view-mode buttons next to it -->
        <Style Selector="Button.sort">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="Button.sort:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <!-- While the menu is open -->
        <Style Selector="Button.sort:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcNavGroupBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
        </Style>
        <Style Selector="Button.sort:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcDisabledTextBrush}" />
        </Style>

        <!-- ===== Drop-down: laid out like a GNOME (libadwaita) popover menu, as in Nautilus ===== -->
        <!-- Every row: 10 padding, a 16 wide glyph slot (radio circle or check mark), 10 gap, the label.
             The title starts where the labels start: 10 + 16 + 10 -->
        <Style Selector="FlyoutPresenter.sort-menu">
            <Setter Property="Background" Value="{DynamicResource FcCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style Selector="TextBlock.menu-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
            <Setter Property="Margin" Value="36,6,10,6" />
        </Style>

        <!-- A menu radio: an outlined circle with a dot when picked, no accent fill; the whole row lights up on hover -->
        <Style Selector="RadioButton.sort-option">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid ColumnDefinitions="16,*">
                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Name="Ring"
                                         Width="14" Height="14"
                                         StrokeThickness="1.5"
                                         Stroke="{TemplateBinding Foreground}"
                                         Opacity="0.5" />
                                <Ellipse Name="Dot"
                                         Width="6" Height="6"
                                         Fill="{TemplateBinding Foreground}"
                                         IsVisible="False" />
                            </Panel>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.sort-option:checked /template/ Ellipse#Ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="RadioButton.sort-option:checked /template/ Ellipse#Dot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="RadioButton.sort-option:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
        </Style>
        <Style Selector="RadioButton.sort-option:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        </Style>

        <!-- Edge to edge, like the separators of a popover menu.
             Not FcDividerBrush: that is Surface0, the same color as the menu background -->
        <Style Selector="Border.menu-separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="-6,6" />
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        </Style>

        <!-- A checkable menu row: a check mark in the glyph slot when on, nothing when off -->
        <Style Selector="ToggleButton.menu-check">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.menu-check:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.menu-check:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.menu-check:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="TextBlock.shortcut">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="Toggle"
            Classes="sort"
            IsEnabled="{Binding IsFolderPage}"
            ToolTip.Tip="Sort">
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="sort-menu">
                <StackPanel>
                    <TextBlock Classes="menu-title" Text="Sort" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="A-Z"
                                 IsChecked="{Binding IsSortedAToZ, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.NameAscending}" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="Z-A"
                                 IsChecked="{Binding IsSortedZToA, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.NameDescending}" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="Last Modified"
                                 IsChecked="{Binding IsSortedNewestFirst, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.NewestFirst}" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="First Modified"
                                 IsChecked="{Binding IsSortedOldestFirst, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.OldestFirst}" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="Size"
                                 IsChecked="{Binding IsSortedBySize, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.LargestFirst}" />
                    <RadioButton Classes="sort-option" GroupName="file-sort" Content="Type"
                                 IsChecked="{Binding IsSortedByType, Mode=TwoWay}" Click="OnOptionClick"
                                 Command="{Binding ApplySortCommand}"
                                 CommandParameter="{x:Static browser:FileSortMode.Type}" />

                    <Border Classes="menu-separator" />

                    <!-- Same columns as the radio rows (16 glyph slot, 10 gap), so check and labels line up with them -->
                    <ToggleButton Classes="menu-check"
                                  IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}"
                                  Click="OnOptionClick">
                        <Grid ColumnDefinitions="16,*,Auto">
                            <avalonia:MaterialIcon Grid.Column="0"
                                                   Kind="Check"
                                                   Width="16" Height="16"
                                                   IsVisible="{Binding ShowHiddenFiles}" />
                            <TextBlock Grid.Column="1"
                                       Text="Show Hidden Files"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Classes="shortcut"
                                       Text="Ctrl+H"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
        <avalonia:MaterialIcon Kind="SortVariant" Width="18" Height="18" />
    </Button>
</UserControl>
