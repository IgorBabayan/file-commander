<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:browser="clr-namespace:File.Commander.Presentation.ViewModels.Browser"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="File.Commander.Presentation.Views.Browser.DirectoryView"
             x:DataType="browser:DirectoryViewModel">
    <!-- Fc* brushes live in MainWindow.Resources, so they must be DynamicResource here:
         a UserControl is parsed on its own and StaticResource can't see the window. -->
    <UserControl.Styles>
        <!-- ===== List and grid: same items, same selection look ===== -->
        <Style Selector="ListBox.files">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FcAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>

        <!-- ===== List ===== -->
        <Style Selector="ListBox.file-list">
            <Setter Property="Padding" Value="12,0,12,12" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===== Grid ===== -->
        <Style Selector="ListBox.file-grid">
            <Setter Property="Padding" Value="14,14,14,12" />
        </Style>
        <Style Selector="ListBox.file-grid ListBoxItem">
            <Setter Property="Width" Value="112" />
            <Setter Property="Padding" Value="8,12,8,10" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!-- ===== Tree: a quieter selection, so folder and file glyphs keep their colors ===== -->
        <Style Selector="TreeView.file-tree">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0,12,12" />
        </Style>
        <Style Selector="TreeView.file-tree TreeViewItem" x:DataType="browser:FileTreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding !IsPlaceholder}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
        </Style>
        <Style Selector="TreeView.file-tree TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
        </Style>
        <Style Selector="TreeView.file-tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        </Style>
        <Style Selector="TreeView.file-tree TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        </Style>

        <!-- ===== Glyphs and secondary text. Order matters: later styles win, so :selected comes last ===== -->
        <Style Selector="avalonia|MaterialIcon.entry-icon">
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
        </Style>
        <Style Selector="avalonia|MaterialIcon.entry-icon.folder">
            <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem:selected avalonia|MaterialIcon.entry-icon">
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem:selected TextBlock.meta">
            <Setter Property="Foreground" Value="{DynamicResource FcOnAccentBrush}" />
        </Style>

        <!-- ===== Column headers (list and tree) ===== -->
        <!-- margin = control padding + item padding; the tree adds the expander column -->
        <Style Selector="Grid.column-headers">
            <Setter Property="Margin" Value="22,14,22,6" />
        </Style>
        <Style Selector="Grid.column-headers.tree">
            <Setter Property="Margin" Value="48,14,22,6" />
        </Style>
        <Style Selector="TextBlock.column-header">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FcHeaderTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Same columns as the rows. The grid has no columns, so no headers -->
        <Grid Grid.Row="0"
              Classes="column-headers"
              Classes.tree="{Binding IsTreeView}"
              ColumnDefinitions="28,*,170,90"
              IsVisible="{Binding !IsGridView}">
            <TextBlock Grid.Column="1" Classes="column-header" Text="Name" />
            <TextBlock Grid.Column="2" Classes="column-header" Text="Modified" />
            <TextBlock Grid.Column="3" Classes="column-header" Text="Size" HorizontalAlignment="Right" />
        </Grid>

        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Bottom"
                     Height="2" MinHeight="2" />

        <Panel Grid.Row="1" IsVisible="{Binding !HasError}">
            <!-- ===== List ===== -->
            <ListBox x:Name="FileList"
                     Classes="files file-list"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry}"
                     IsVisible="{Binding IsListView}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="browser:FileEntryViewModel">
                        <Grid ColumnDefinitions="28,*,170,90" ToolTip.Tip="{Binding FullPath}">
                            <avalonia:MaterialIcon Grid.Column="0"
                                                   Classes="entry-icon"
                                                   Classes.folder="{Binding IsDirectory}"
                                                   Kind="{Binding Icon}"
                                                   Width="20" Height="20"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Classes="meta"
                                       Text="{Binding ModifiedText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Classes="meta"
                                       Text="{Binding SizeText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== Grid ===== -->
            <ListBox x:Name="GridList"
                     Classes="files file-grid"
                     ItemsSource="{Binding GridEntries}"
                     SelectedItem="{Binding SelectedEntry}"
                     IsVisible="{Binding IsGridView}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="browser:FileEntryViewModel">
                        <StackPanel Spacing="8" ToolTip.Tip="{Binding FullPath}">
                            <avalonia:MaterialIcon Classes="entry-icon"
                                                   Classes.folder="{Binding IsDirectory}"
                                                   Kind="{Binding Icon}"
                                                   Width="48" Height="48"
                                                   HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== Tree: folders expand in place and are read on first expand ===== -->
            <TreeView x:Name="FileTree"
                      Classes="file-tree"
                      ItemsSource="{Binding TreeRoots}"
                      IsVisible="{Binding IsTreeView}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="browser:FileTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="28,*,170,90" ToolTip.Tip="{Binding FullPath}">
                            <avalonia:MaterialIcon Grid.Column="0"
                                                   Classes="entry-icon"
                                                   Classes.folder="{Binding IsDirectory}"
                                                   Kind="{Binding Icon}"
                                                   IsVisible="{Binding !IsPlaceholder}"
                                                   Width="20" Height="20"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes.placeholder="{Binding IsPlaceholder}"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Classes="meta"
                                       Text="{Binding ModifiedText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Classes="meta"
                                       Text="{Binding SizeText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Panel>

        <TextBlock Grid.Row="1"
                   Text="This folder is empty"
                   IsVisible="{Binding IsEmpty}"
                   FontSize="14"
                   Foreground="{DynamicResource FcSubtleTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding HasError}"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <avalonia:MaterialIcon Kind="FolderAlertOutline"
                                   Width="56" Height="56"
                                   Foreground="{DynamicResource FcHeaderTextBrush}" />
            <TextBlock Text="{Binding Error}"
                       FontSize="14"
                       Foreground="{DynamicResource FcSubtleTextBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
