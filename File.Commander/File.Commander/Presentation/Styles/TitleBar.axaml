<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <!-- The title bar's view mode and file buttons. Each is a toolbar item of its own (Customize Toolbar…),
         so their styles live here rather than in a control around them. Included by MainWindow.
         Fc* brushes follow the theme: DynamicResource -->

    <!-- ===== Grid / list / tree, split view ===== -->
    <!-- Order matters: later styles win, so .selected and :disabled come last -->
    <Style Selector="Button.view-mode">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.view-mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
    </Style>
    <Style Selector="Button.view-mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
    </Style>

    <!-- The active layout: a filled tile with an accent glyph -->
    <Style Selector="Button.view-mode.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcNavGroupBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
    </Style>
    <Style Selector="Button.view-mode.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
    </Style>

    <!-- Pages without a folder listing (Computer, Trash, ...): nothing to switch -->
    <Style Selector="Button.view-mode:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FcDisabledTextBrush}" />
    </Style>

    <!-- ===== New, Select all, Copy, Paste: Button.nav in the pill of Border.nav-group (MainWindow) ===== -->
    <!-- The file view keeps the focus, so the arrow keys and shortcuts go on working there after a click -->
    <Style Selector="Button.nav.file-action">
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- New and Paste: an icon and a chevron, so wider than the other buttons -->
    <Style Selector="Button.nav.dropdown">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Padding" Value="9,0,6,0" />
    </Style>
    <Style Selector="Button.nav.dropdown avalonia|MaterialIcon.chevron">
        <Setter Property="Foreground" Value="{DynamicResource FcSubtleTextBrush}" />
    </Style>
    <!-- While the menu is open -->
    <Style Selector="Button.nav:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcAccentBrush}" />
    </Style>

    <!-- Drop-down, like the sort menu -->
    <Style Selector="FlyoutPresenter.file-menu">
        <Setter Property="Background" Value="{DynamicResource FcCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FcHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="Button.menu-row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
    </Style>
    <Style Selector="Button.menu-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
    </Style>
    <Style Selector="Button.menu-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FcPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FcTextBrush}" />
    </Style>
    <Style Selector="Button.menu-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FcDisabledTextBrush}" />
    </Style>
</Styles>
